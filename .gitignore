# Research data supplied by the author, not redistributed from this repository.
# The record words are Keranen / Gavrilenko's; word-anatomy.js verifies them
# locally and every consumer skips cleanly when they are absent.
datasets/keranen_*.txt
keranen_*.txt

# Copyrighted papers. Cited in MATH_CLAIMS.md, never redistributed.
papers/*.pdf
latest/*.pdf
*.pdf

# Personal research notes and correspondence, not for redistribution.
teoria/

# Local cache of extension-depth tables (table-library.js). Regenerable by
# construction and large; every record carries its own checksum and provenance,
# so a missing cache costs time, never correctness.
tables/

# Derived from MATH_CLAIMS.md by claims-export.js. Regenerate, never edit.
claims.json
